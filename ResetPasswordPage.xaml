<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.ResetPasswordPage"
    BackgroundColor="#101F18">

    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="12">

            <Label Text="✿ PhytoGuard"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="White" />

            <Label Text="Nouveau mot de passe"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,24,0,0" />

            <Label Text="Saisissez votre téléphone, le code reçu, puis choisissez un nouveau mot de passe."
                   FontSize="13"
                   TextColor="#B8C7BC"
                   Margin="0,0,0,12" />

            <Label Text="Téléphone"
                   FontSize="12"
                   TextColor="#B8C7BC" />

            <Entry Placeholder=""
                   Keyboard="Telephone"
                   TextColor="White"
                   BackgroundColor="#20362A"
                   HeightRequest="50" />

            <Button Text="Envoyer un code SMS"
                    BackgroundColor="#20362A"
                    TextColor="White"
                    CornerRadius="12"
                    HeightRequest="48" />

            <Label Text="Code de vérification"
                   FontSize="12"
                   TextColor="#B8C7BC"
                   Margin="0,8,0,0" />

            <Entry Placeholder=""
                   Keyboard="Numeric"
                   TextColor="White"
                   BackgroundColor="#20362A"
                   HeightRequest="50" />

            <Label Text="Nouveau mot de passe"
                   FontSize="12"
                   TextColor="#B8C7BC"
                   Margin="0,8,0,0" />

            <Entry Placeholder=""
                   IsPassword="True"
                   TextColor="White"
                   BackgroundColor="#20362A"
                   HeightRequest="50" />

            <Label Text="Confirmer le nouveau mot de passe"
                   FontSize="12"
                   TextColor="#B8C7BC"
                   Margin="0,8,0,0" />

            <Entry Placeholder=""
                   IsPassword="True"
                   TextColor="White"
                   BackgroundColor="#20362A"
                   HeightRequest="50" />

            <Button Text="Enregistrer le nouveau mot de passe"
                    BackgroundColor="#347A4C"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="52"
                    Margin="0,12,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>