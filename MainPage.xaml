<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.MainPage"
    BackgroundColor="#101F18">

    <Grid RowDefinitions="*,Auto"
          Padding="20,12,20,12">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">

                <!-- En-tête -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="0,0,0,18">

                    <Label
                        Text="✿ Phyto"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        VerticalOptions="Center" />

                    <Label
                        Grid.Column="1"
                        Text="Guard"
                        FontSize="13"
                        FontAttributes="Bold"
                        TextColor="#A4D6AE"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Illustration végétale -->
                <Border
                    HeightRequest="205"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24"
                    Margin="4,0,4,18">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F3E6AA" Offset="0.0" />
                            <GradientStop Color="#D7DF99" Offset="0.55" />
                            <GradientStop Color="#A8C875" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Ellipse
                            WidthRequest="130"
                            HeightRequest="130"
                            Fill="#FFFFFF"
                            Opacity="0.17"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Ellipse
                            WidthRequest="58"
                            HeightRequest="148"
                            Fill="#286B42"
                            Rotation="32"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

                        <Ellipse
                            WidthRequest="20"
                            HeightRequest="108"
                            Fill="#A6D36D"
                            Rotation="32"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Présentation -->
                <Label
                    Text="Des cultures en&#10;meilleure santé"
                    FontSize="25"
                    FontAttributes="Bold"
                    TextColor="White"
                    LineHeight="1.05" />

                <Label
                    Text="Repérez les problèmes et trouvez les bons gestes pour vos cultures."
                    FontSize="13"
                    TextColor="#B8C7BC"
                    LineHeight="1.2"
                    Margin="0,7,0,16" />

                <!-- Fonctions de l’application -->
                <Border
                    BackgroundColor="#20362A"
                    Stroke="#304B38"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="14"
                    Margin="0,0,0,12">

                    <Label
                        Text="Photo · Conseils · Suivi de parcelle"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>

                <Label
                    Text="Votre assistant agricole sur le terrain."
                    FontSize="13"
                    TextColor="#B8C7BC"
                    Margin="0,0,0,20" />

                <!-- Boutons -->
                <Button
                    Text="Se connecter"
                    BackgroundColor="#347A4C"
                    TextColor="White"
                    FontSize="15"
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="54" 
                    Clicked="OnLoginClicked"/>

                <Button
                     Text="Créer mon compte"
                     BackgroundColor="#20362A"
                     TextColor="White"
                     FontSize="15"
                      FontAttributes="Bold"
                     CornerRadius="14"
                     HeightRequest="50"
                     Margin="0,11,0,14"
                     Clicked="OnCreateAccountClicked" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Navigation basse : l’onglet s’appelle Bienvenue -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            Padding="8,12,8,2"
            BackgroundColor="#13251B">

            <Label
                Text="Bienvenue"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#A4D6AE"
                HorizontalOptions="Start" />

            <Label
                Grid.Column="1"
                Text="Découvrir"
                FontSize="12"
                TextColor="#D5DED7"
                HorizontalOptions="End" />
        </Grid>

    </Grid>
</ContentPage>