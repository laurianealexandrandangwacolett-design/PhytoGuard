<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.TakePhotoPage"
    BackgroundColor="#101F18">

    <Grid RowDefinitions="*,Auto">

        <!-- Contenu défilant de la page photo -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="12,16"
                                 Spacing="12">

                <Label Text="‹ Nouveau diagnostic"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="0,0,0,8" />

                <Label Text="Photographier la plante"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label Text="Cadrez une feuille ou les symptômes visibles."
                       FontSize="12"
                       TextColor="#B8C7BC" />

                <!-- Aperçu de la photo -->
                <Border BackgroundColor="#20362A"
                        Stroke="#304B38"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        HeightRequest="220"
                        Padding="6">

                    <Grid>
                        <Image x:Name="PhotoPreview"
                               Aspect="AspectFill" />

                        <Label x:Name="PhotoHintLabel"
                               Text="Votre photo apparaîtra ici"
                               FontSize="13"
                               TextColor="#B8C7BC"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Conseil photo -->
                <Border BackgroundColor="#20362A"
                        Stroke="#304B38"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Pour une photo nette"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="Placez la feuille à la lumière et évitez le flou."
                               FontSize="11"
                               TextColor="#B8C7BC" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Prendre une photo"
                        Clicked="OnTakePhotoClicked"
                        BackgroundColor="#347A4C"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48" />

                <Button Text="Choisir dans la galerie"
                        Clicked="OnChoosePhotoClicked"
                        BackgroundColor="#20362A"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="46" />

                <Label Text="La photo est gardée sur votre téléphone."
                       FontSize="10"
                       TextColor="#B8C7BC"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,8" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Barre de navigation fixée en bas -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              Padding="6,10"
              BackgroundColor="#0C1812">

            <Label Grid.Column="0"
                   Text="Culture"
                   TextColor="#B8C7BC"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCultureTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="1"
                   Text="Photo"
                   TextColor="#A4D6AE"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPhotoTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="2"
                   Text="Symptômes"
                   TextColor="#B8C7BC"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSymptomsTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Grid.Column="3"
                   Text="Résultat"
                   TextColor="#B8C7BC"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnResultTapped" />
                </Label.GestureRecognizers>
            </Label>

        </Grid>

    </Grid>
</ContentPage>