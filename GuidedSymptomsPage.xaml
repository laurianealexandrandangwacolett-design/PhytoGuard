<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.GuidedSymptomsPage"
    BackgroundColor="#101F18">

    <ScrollView>
        <VerticalStackLayout Padding="16,12"
                             Spacing="12">

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="‹ Nouveau diagnostic"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="White" />
            </Grid>

            <Label Text="Décrivons les symptômes"
                   FontSize="23"
                   FontAttributes="Bold"
                   TextColor="White" />

            <Label Text="Ces détails aideront à analyser la photo."
                   FontSize="12"
                   TextColor="#B8C7BC" />

            <!-- Aperçu de la photo sélectionnée -->
            <Border BackgroundColor="#20362A"
                    Stroke="#304B38"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    HeightRequest="190"
                    Padding="4">

                <Grid>
                    <Image x:Name="SymptomPhotoPreview"
                           Aspect="AspectFit"
                           IsVisible="False" />

                    <Label x:Name="NoPhotoLabel"
                           Text="Aucune photo sélectionnée"
                           TextColor="#B8C7BC"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Culture enregistrée -->
            <Border BackgroundColor="#20362A"
                    Stroke="#304B38"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    Padding="12">

                <Label x:Name="SavedCropLabel"
                       Text="Culture de la parcelle : chargement..."
                       TextColor="White"
                       FontAttributes="Bold" />
            </Border>

            <Label Text="Que voyez-vous ?"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,4,0,0" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="YellowSpotsCheck"
                          Color="#62A879" />
                <Label Text="Taches jaunes"
                       TextColor="#D5DED7"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="DryLeavesCheck"
                          Color="#62A879" />
                <Label Text="Feuilles sèches"
                       TextColor="#D5DED7"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="WhitePowderCheck"
                          Color="#62A879" />
                <Label Text="Poudre blanche"
                       TextColor="#D5DED7"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Depuis quand avez-vous remarqué ces symptômes ?"
                   FontSize="13"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,4,0,0" />

            <Picker x:Name="DurationPicker"
                    Title="Choisir une période"
                    TextColor="White"
                    BackgroundColor="#20362A">
                <Picker.Items>
                    <x:String>Aujourd’hui</x:String>
                    <x:String>Depuis quelques jours</x:String>
                    <x:String>Depuis une semaine ou plus</x:String>
                </Picker.Items>
            </Picker>

            <Button Text="Continuer"
                    Clicked="OnContinueClicked"
                    BackgroundColor="#347A4C"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="12"
                    HeightRequest="50"
                    Margin="0,8,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>