<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PhytoGuard.Controls.StepBar">
    <Border Style="{StaticResource CardStyle}" Padding="8">
        <Grid ColumnDefinitions="*,*,*,*">
            <Label x:Name="L1" Grid.Column="0" Text="Culture" HorizontalTextAlignment="Center" FontSize="12" />
            <Label x:Name="L2" Grid.Column="1" Text="Photo" HorizontalTextAlignment="Center" FontSize="12" />
            <Label x:Name="L3" Grid.Column="2" Text="Symptômes" HorizontalTextAlignment="Center" FontSize="12" />
            <Label x:Name="L4" Grid.Column="3" Text="Résultat" HorizontalTextAlignment="Center" FontSize="12" />
        </Grid>
    </Border>
</ContentView>
