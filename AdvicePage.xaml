<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.AdvicePage"
    BackgroundColor="#101F18">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12,8">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="06:18" FontSize="10" TextColor="White" />
            <Label Grid.Column="1" Text="99%" FontSize="10" TextColor="White" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Label Text=" Conseils"
                       Margin="0,12,0,0"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label x:Name="CropSubtitle"
                       FontSize="12"
                       TextColor="#B8C7BC" />

                <Border BackgroundColor="#20362A"
                        Stroke="#304B38"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="PRÉVENTION · CETTE SEMAINE"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="#A4D6AE" />
                        <Label x:Name="PreventionTitle"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="PreventionText"
                               FontSize="12"
                               TextColor="#B8C7BC" />
                    </VerticalStackLayout>
                </Border>

                <Border BackgroundColor="#20362A"
                        Stroke="#304B38"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 14"
                        Padding="12">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Fiche pratique"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="White" />
                        <Label x:Name="PracticalText"
                               FontSize="12"
                               TextColor="#B8C7BC" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Voir l’historique"
                        Clicked="OnHistoryClicked"
                        BackgroundColor="#347A4C"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="48" />

                <Label Text="Avant tout traitement, vérifiez les instructions du produit ou demandez conseil à un spécialiste."
                       FontSize="10"
                       TextColor="#B8C7BC"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*,*"
              Padding="0,12,0,2"
              BackgroundColor="#13251B">
            <Label Text="Accueil"
       TextColor="#B8C7BC"
       HorizontalTextAlignment="Center">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnHomeTapped" />
    </Label.GestureRecognizers>
</Label><Label Grid.Column="1"
       Text="Parcelles"
       TextColor="#B8C7BC"
       HorizontalTextAlignment="Center">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnParcelsTapped" />
    </Label.GestureRecognizers>
</Label>
            <Label Grid.Column="2" Text="Historique" FontSize="10"
                   TextColor="#D5DED7" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistoryClicked" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="3" Text="Conseils" FontSize="10"
                   FontAttributes="Bold" TextColor="#A4D6AE"
                   HorizontalOptions="Center" />
        </Grid>

    </Grid>
</ContentPage>