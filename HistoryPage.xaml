<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.HistoryPage"
    BackgroundColor="#101F18">

    <Grid RowDefinitions="Auto,*,Auto" Padding="12,8">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label Text="06:18" FontSize="10" TextColor="White" />
            <Label Grid.Column="1" Text="99%" FontSize="10" TextColor="White" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">

                <Label Text="◷ Historique"
                       Margin="0,12,0,0"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label x:Name="ParcelLabel"
                       FontSize="17"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label x:Name="CropLabel"
                       FontSize="12"
                       TextColor="#B8C7BC" />

                <Label Text="Observations récentes"
                       Margin="0,8,0,0"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label x:Name="EmptyLabel"
                       IsVisible="False"
                       TextColor="#B8C7BC"
                       FontSize="12" />

                <VerticalStackLayout x:Name="RecordsLayout" Spacing="10" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2"
              ColumnDefinitions="*,*,*,*"
              Padding="0,12,0,2"
              BackgroundColor="#13251B">
            <Label Text="Accueil"
       TextColor="#B8C7BC"
       HorizontalTextAlignment="Center">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnHomeTapped" />
    </Label.GestureRecognizers>
</Label>
            <Label Grid.Column="1" Text="Parcelles" FontSize="10"
                   TextColor="#D5DED7" HorizontalOptions="Center" />
            <Label Grid.Column="2" Text="Historique" FontSize="10"
                   FontAttributes="Bold" TextColor="#A4D6AE"
                   HorizontalOptions="Center" />
           <Label Grid.Column="3"
       Text="Conseils"
       FontSize="10"
       TextColor="#D5DED7"
       HorizontalOptions="Center">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnAdviceTapped" />
    </Label.GestureRecognizers>
</Label>
        </Grid>

    </Grid>
</ContentPage>