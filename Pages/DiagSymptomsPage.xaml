<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:PhytoGuard.Controls"
             x:Class="PhytoGuard.Pages.DiagSymptomsPage" Title="Nouveau diagnostic" Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <controls:StepBar Current="3" />
            <Label Text="Décrivons les symptômes" Style="{StaticResource H1}" />
            <Label Text="Ces détails aideront à analyser la photo." Style="{StaticResource Muted}" />
            <Border Style="{StaticResource CardStyle}" Padding="12">
                <Label Text="{Binding CultureText}" FontAttributes="Bold" />
            </Border>
            <Label Text="Que voyez-vous ?" FontAttributes="Bold" />
            <VerticalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding IsChecked}" VerticalOptions="Center" />
                            <Label Text="{Binding Label}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Label Text="Depuis quand avez-vous remarqué ces symptômes ?" FontAttributes="Bold" />
            <Border Style="{StaticResource CardStyle}" Padding="12,4">
                <Picker Title="Choisir une période" ItemsSource="{Binding Durations}" SelectedItem="{Binding SelectedDuration}" />
            </Border>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Button Text="Continuer" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
