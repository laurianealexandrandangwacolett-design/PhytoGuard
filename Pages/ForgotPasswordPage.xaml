<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:PhytoGuard.Controls"
             x:Class="PhytoGuard.Pages.ForgotPasswordPage" Title="Mot de passe oublié" Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Nouveau mot de passe" Style="{StaticResource H1}" />
            <Label Text="Saisissez votre téléphone, le code reçu, puis choisissez un nouveau mot de passe." Style="{StaticResource Muted}" />
            <controls:LabeledEntry Title="Téléphone" Keyboard="Telephone" Text="{Binding Phone}" />
            <Button Text="Envoyer un code SMS" Style="{StaticResource SecondaryButton}" Command="{Binding SendCodeCommand}" />
            <controls:LabeledEntry Title="Code de vérification" Keyboard="Numeric" Text="{Binding Code}" />
            <controls:LabeledEntry Title="Nouveau mot de passe" IsPassword="True" Text="{Binding NewPassword}" />
            <controls:LabeledEntry Title="Confirmer le nouveau mot de passe" IsPassword="True" Text="{Binding ConfirmPassword}" />
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
            <Button Text="Enregistrer le nouveau mot de passe" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
