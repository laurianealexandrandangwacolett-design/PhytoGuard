<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:PhytoGuard.Controls" xmlns:vm="clr-namespace:PhytoGuard.ViewModels"
             x:Class="PhytoGuard.Pages.DiagResultPage" Title="Résultat" Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <controls:StepBar Current="4" />
            <Label Text="{Binding Headline}" Style="{StaticResource H1}" FontSize="22" />
            <Image Source="{Binding Photo}" IsVisible="{Binding HasPhoto}" HeightRequest="180" Aspect="AspectFill" />
            <Label Text="{Binding Summary}" Style="{StaticResource Muted}" />
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Results}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer CommandParameter="{Binding .}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DiagResultViewModel}}, Path=OpenDiseaseCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                                <Label Text="{Binding Disease.Name}" FontAttributes="Bold" />
                                <Label Grid.Column="1" Text="{Binding ConfidenceText}" TextColor="{StaticResource PrimaryLight}" FontAttributes="Bold" />
                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="Voir la fiche et les conseils de traitement ›" Style="{StaticResource Muted}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="Prendre rendez-vous avec un spécialiste" Style="{StaticResource SecondaryButton}" Command="{Binding ExpertsCommand}" />
            <Button Text="Terminer" Style="{StaticResource PrimaryButton}" Command="{Binding DoneCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
