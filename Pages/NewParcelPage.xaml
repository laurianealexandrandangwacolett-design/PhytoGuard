<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:PhytoGuard.Controls"
             x:Class="PhytoGuard.Pages.NewParcelPage" Title="Nouvelle parcelle" Shell.NavBarIsVisible="True">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Localiser la parcelle" Style="{StaticResource H1}" />
            <Label Text="Le GPS enregistre la position même sans internet." Style="{StaticResource Muted}" />
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HeightRequest="24" />
                    <Button Text="Localiser ma position" Style="{StaticResource PrimaryButton}" Command="{Binding LocateCommand}" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="COORDONNÉES GPS" Style="{StaticResource Muted}" FontSize="10" />
                    <Label Text="{Binding CoordsText}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <controls:LabeledEntry Title="Nom de la parcelle" Text="{Binding ParcelName}" />
            <Border Style="{StaticResource CardStyle}" Padding="12,8">
                <VerticalStackLayout>
                    <Label Text="Culture" Style="{StaticResource Muted}" FontSize="11" />
                    <Picker Title="Choisir la culture" ItemsSource="{Binding Crops}" SelectedItem="{Binding Crop}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}" />
            <Button Text="Enregistrer hors ligne" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
            <Label Text="Fond de carte à télécharger avant le départ." Style="{StaticResource Muted}" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
