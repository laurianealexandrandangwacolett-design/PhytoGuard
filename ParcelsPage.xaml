<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.ParcelsPage"
    BackgroundColor="#101F18">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18" Spacing="14">

                <Label Text="Mes parcelles"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="White" />

                <Label x:Name="EmptyMessageLabel"
                       Text="Aucune parcelle enregistrée pour le moment."
                       TextColor="#B8C7BC"
                       IsVisible="False" />

                <Border x:Name="ParcelCard"
                        BackgroundColor="#20362A"
                        Stroke="#304B38"
                        StrokeShape="RoundRectangle 14"
                        Padding="16"
                        IsVisible="False">

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Nom de la parcelle"
                               FontSize="12"
                               TextColor="#AAB9AD" />

                        <Label x:Name="ParcelNameLabel"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="White" />

                        <Label Text="Culture"
                               FontSize="12"
                               TextColor="#AAB9AD" />

                        <Label x:Name="CropLabel"
                               FontSize="16"
                               TextColor="White" />

                        <Label Text="Coordonnées GPS"
                               FontSize="12"
                               TextColor="#AAB9AD" />

                        <Label x:Name="CoordinatesLabel"
                               FontSize="14"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="+ Ajouter une parcelle GPS"
                        Clicked="OnAddParcelClicked"
                        BackgroundColor="#347A4C"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="48" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,*,*,*"
              Padding="6"
              BackgroundColor="#0C1812">

            <Label Grid.Column="0"
       Text="Accueil"
       TextColor="#B8C7BC"
       HorizontalTextAlignment="Center">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnHomeTapped" />
    </Label.GestureRecognizers>
</Label>
<Label Grid.Column="1"
                   Text="Parcelles"
                   TextColor="#A4D6AE"
                   HorizontalTextAlignment="Center" />
<Label Grid.Column="2"
       Text="Historique"
       TextColor="#B8C7BC"
       HorizontalTextAlignment="Center">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnHistoryTapped" />
    </Label.GestureRecognizers>
</Label>

<Label Grid.Column="3"
       Text="Conseils"
       TextColor="#B8C7BC"
       HorizontalTextAlignment="Center">
    <Label.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnAdviceTapped" />
    </Label.GestureRecognizers>
</Label>
            
        </Grid>

    </Grid>
</ContentPage>