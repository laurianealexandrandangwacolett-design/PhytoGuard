<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PhytoGuard.AccountPage"
    BackgroundColor="#101F18">

    <VerticalStackLayout Padding="20" Spacing="16">
        <Label Text="Mon compte"
               FontSize="26"
               FontAttributes="Bold"
               TextColor="White" />

        <Label x:Name="AccountNameLabel"
               TextColor="White" />

        <Label x:Name="AccountPhoneLabel"
               TextColor="#B8C7BC" />

        <Button Text="Retour"
                Clicked="OnBackClicked"
                BackgroundColor="#347A4C"
                TextColor="White" />
    </VerticalStackLayout>
</ContentPage>